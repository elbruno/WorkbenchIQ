{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting": "Information"
    }
  },
  "Parameters": {
    "ApiKey": "",
    "EnablePostgres": false,
    "StorageBackend": "local",
    "DatabaseBackend": "json",
    
    "ContentUnderstanding": {
      "Endpoint": "",
      "ApiKey": "",
      "AnalyzerId": "prebuilt-documentSearch",
      "ApiVersion": "2025-11-01",
      "UseAzureAD": "true",
      "CompletionDeployment": "",
      "EmbeddingDeployment": ""
    },
    
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": "",
      "ApiVersion": "2024-10-21",
      "ModelName": "gpt-4.1",
      "UseAzureAD": "true",
      "ChatDeploymentName": "",
      "ChatModelName": "",
      "ChatApiVersion": "",
      "FallbackEndpoint": "",
      "FallbackApiKey": "",
      "FallbackDeploymentName": "",
      "FallbackApiVersion": "",
      "FallbackUseAzureAD": "false"
    },
    
    "AzureStorage": {
      "AccountName": "",
      "AccountKey": "",
      "ContainerName": "",
      "TimeoutSeconds": "30",
      "RetryTotal": "3"
    },
    
    "PostgreSQL": {
      "SslMode": "prefer",
      "Schema": "public"
    },
    
    "App": {
      "StorageRoot": "data",
      "PromptsRoot": "prompts",
      "PublicFilesBaseUrl": ""
    },
    
    "RAG": {
      "Enabled": "false",
      "TopK": "5",
      "SimilarityThreshold": "0.5",
      "EmbeddingModel": "text-embedding-3-small",
      "EmbeddingDimensions": "1536",
      "EmbeddingDeployment": ""
    },
    
    "Processing": {
      "LargeDocThresholdKb": "1500",
      "ChunkSizeChars": "50000",
      "MaxSamplePages": "15",
      "CondensedContextMaxChars": "40000",
      "AutoDetectMode": "true"
    },
    
    "AutomotiveClaims": {
      "Enabled": "true",
      "DocAnalyzer": "autoClaimsDocAnalyzer",
      "ImageAnalyzer": "autoClaimsImageAnalyzer",
      "VideoAnalyzer": "autoClaimsVideoAnalyzer",
      "PoliciesPath": "prompts/automotive-claims-policies.json",
      "VideoMaxDurationMinutes": "10",
      "ImageMaxSizeMb": "20"
    },
    
    "MortgageUnderwriting": {
      "Enabled": "true",
      "DocAnalyzer": "mortgageDocAnalyzer",
      "PoliciesPath": "prompts/mortgage-underwriting-policies.json",
      "OsfiMqrFloorPct": "5.25",
      "OsfiMqrBufferPct": "2.0",
      "GdsLimitStandard": "0.39",
      "TdsLimitStandard": "0.44",
      "LtvLimitConventional": "0.80",
      "LtvLimitInsured": "0.95",
      "MaxAmortInsured": "25",
      "MaxAmortUninsured": "30"
    },
    
    "Frontend": {
      "AuthSecret": "",
      "AuthUser1": "",
      "AuthUser2": "",
      "AuthUser3": "",
      "AuthUser4": "",
      "AuthUser5": ""
    }
  }
}
